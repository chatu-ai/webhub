{
  "name": "@chatu-ai/webhub",
  "version": "0.1.3",
  "description": "OpenClaw Channel SDK - Build custom channel plugins",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "channel": {
      "id": "chatu",
      "label": "Chatu",
      "selectionLabel": "Chatu (HTTP/WebSocket)",
      "docsPath": "/channels/chatu",
      "docsLabel": "chatu",
      "blurb": "Connect to any website via HTTP/WebSocket",
      "order": 60,
      "aliases": [
        "chatu",
        "http-channel"
      ]
    },
    "install": {
      "npmSpec": "@chatu-ai/webhub",
      "defaultChoice": "npm"
    }
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "check": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "prepare": "npm run build",
    "test": "jest --no-coverage",
    "release:patch": "npm version patch && git push --follow-tags",
    "release:minor": "npm version minor && git push --follow-tags",
    "release:major": "npm version major && git push --follow-tags"
  },
  "keywords": [
    "openclaw",
    "channel",
    "sdk"
  ],
  "author": "OpenClaw Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/chatu-ai/webhub.git"
  },
  "bugs": {
    "url": "https://github.com/chatu-ai/webhub/issues"
  },
  "homepage": "https://github.com/chatu-ai/webhub",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@chatu-ai/webhub": "^0.1.3",
    "@sinclair/typebox": "^0.32.0",
    "@types/uuid": "^10.0.0",
    "uuid": "^13.0.0",
    "ws": "^8.14.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^20.0.0",
    "@types/ws": "^8.5.0",
    "jest": "^30.2.0",
    "openclaw": "^2026.4.22",
    "ts-jest": "^29.4.6",
    "typescript": "^5.3.0"
  }
}
